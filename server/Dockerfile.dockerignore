# BuildKit은 Dockerfile 옆의 <이름>.dockerignore를 쓴다: 이미지에 필요한 파일만(서버 5개 + 채팅 금칙어 목록) 보낸다(node_modules·에셋 수백 MB 제외)
*
!package.json
!src/multi-protocol.js
!src/christmas/tree-state.js
!src/christmas/room-play.js
!src/christmas/gift-state.js
!src/christmas/snowman-state.js
!src/christmas/snowfight.js
!src/christmas/layout.js
!src/christmas/festive-layout.js
!src/christmas/fight-match.js
!src/christmas/sled-race.js
!src/christmas/sled-course.js
!src/christmas/gondola.js
!src/lounge/room-rules.js
!src/namsan/namsan-lock-rules.js
!server/namsan-locks.mjs
!server/ws.mjs
!server/rooms.mjs
!server/multi-server.mjs
!server/chat-banned-words.txt
